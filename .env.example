# Required only when the database has no administrator yet.
AICS_ADMIN_USERNAME=owner
AICS_ADMIN_DISPLAY_NAME=Studio Owner
AICS_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Safe defaults for a publicly reachable HTTPS installation.
AICS_REGISTRATION_ENABLED=0
AICS_COOKIE_SECURE=1
AICS_SESSION_HOURS=12

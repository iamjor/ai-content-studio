# Required only when the database has no administrator yet.
AICS_ADMIN_USERNAME=owner
AICS_ADMIN_DISPLAY_NAME=Studio Owner
AICS_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Safe defaults for a publicly reachable HTTPS installation.
AICS_REGISTRATION_ENABLED=0
AICS_MAX_USERS=100
AICS_REGISTRATION_ATTEMPT_LIMIT=5
AICS_OAUTH_CLIENT_LIMIT=1000
AICS_OAUTH_FLOW_LIMIT=5000
AICS_COOKIE_SECURE=1
AICS_SESSION_HOURS=12

# Exact external HTTPS origin used in OAuth metadata and token audience checks.
# Loopback HTTP is accepted only for local development.
AICS_PUBLIC_BASE_URL=https://studio.example.com

# Leave empty unless the direct peer is a proxy you administer. Use CIDR values.
AICS_TRUSTED_PROXY_NETWORKS=

# Optional. Defaults to /data/images beside the SQLite database.
AICS_IMAGE_ROOT=/data/images

# Optional loopback worker port. Change only to avoid a local port conflict.
AICS_MCP_INTERNAL_PORT=8788
